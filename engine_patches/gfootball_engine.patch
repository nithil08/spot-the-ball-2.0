--- a/third_party/gfootball_engine/src/onthepitch/match.cpp
+++ b/third_party/gfootball_engine/src/onthepitch/match.cpp
@@ -19,6 +19,7 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdlib>
 
 #include "../base/geometry/triangle.hpp"
 #include "../base/log.hpp"
@@ -528,6 +529,37 @@ void Match::UpdateIngameCamera() {
   if (fabs(ballPos.coords[0]) > maxW) ballPos.coords[0] = maxW * signSide(ballPos.coords[0]);
   if (fabs(ballPos.coords[1]) > maxH) ballPos.coords[1] = maxH * signSide(ballPos.coords[1]);
 
+  // Framing offset (spot-the-ball benchmark). The camera target above is the
+  // ball itself, so the ball renders dead centre in every clip and every grid
+  // answer collapses to the middle cells. Shifting the target by a fixed
+  // per-clip amount reframes the shot -- the camera still pans and tracks
+  // exactly as before, the ball just sits off-centre, the way a real operator
+  // frames play. Applied AFTER the follow clamp above: inside it, maxH
+  // saturates the pan well before the ball reaches the top of frame, which
+  // costs the entire top row of the grid. The wider bound here still keeps the
+  // target on the pitch so the view never drifts into the stands. Read per
+  // frame so the generator can set it per clip; unset means byte-identical
+  // behaviour to the stock camera.
+  {
+    const char *offX = getenv("GFOOTBALL_CAM_OFFSET_X");
+    const char *offY = getenv("GFOOTBALL_CAM_OFFSET_Y");
+    if (offX || offY) {
+      if (offX) ballPos.coords[0] += atof(offX);
+      if (offY) ballPos.coords[1] += atof(offY);
+      // Bound the offset target to the PITCH, not to a multiple of the follow
+      // clamp. maxW is already ~1.65x the pitch half-length, so a multiple of it
+      // lets the camera aim past the goal line or over the touchline and fill a
+      // third of the shot with empty seating. Staying inside the playing surface
+      // is what keeps every reframed clip looking like football.
+      const float framedW = pitchHalfW * 0.95f;
+      const float framedH = pitchHalfH * 0.80f;
+      if (fabs(ballPos.coords[0]) > framedW)
+        ballPos.coords[0] = framedW * signSide(ballPos.coords[0]);
+      if (fabs(ballPos.coords[1]) > framedH)
+        ballPos.coords[1] = framedH * signSide(ballPos.coords[1]);
+    }
+  }
+
   Vector3 shudder =
       Vector3(boostrandom(-0.1f, 0.1f), boostrandom(-0.1f, 0.1f), 0) *
       (ball->GetMovement().GetLength() * 0.8f + 6.0f);
