+        // Stock: ONE global goalie texture, so both keepers wear the same kit and a
+        // keeper reads as "a third team" rather than as part of his own side.
+        //
+        // Research hook: with GFOOTBALL_TEAM_GK_KITS set, the keeper's kit is derived
+        // from his own team's kit_url instead, so each side can ship a keeper texture
+        // in its own hue. Opt-in because IMG_LoadBmp dereferences the decoded surface
+        // without a null check — asking for a file a bundle does not carry is a
+        // segfault, and only the bundles built for this benchmark carry the two
+        // "<kit_url>_gk_kit.bmp" files. Unset is byte-identical to stock.
+        //
+        // Note ".png" is the convention throughout this file; IMG_LoadBmp rewrites the
+        // extension to ".bmp" before touching the disk.
+        const char *teamGkKits = getenv("GFOOTBALL_TEAM_GK_KITS");
+        if (teamGkKits && teamGkKits[0] != '\0' && teamGkKits[0] != '0') {
+          DO_VALIDATION;
+          kitFilename = GetTeamData()->GetKitUrl() + "_gk_kit.png";
+        } else {
+          kitFilename = "media/objects/players/textures/goalie_kit.png";
+        }
       }
       kit = GetContext().surface_manager.Fetch(kitFilename);
       player->Activate(
           playerNode, fullbodyNode,
           colorCoords, kit, match->GetAnimCollection(), formation.lazy);
+
+      // Research hook: selectively hide players while keeping them fully in the
+      // simulation, by shrinking the RENDERED body to ~invisible (renderScale, the
+      // same mechanism used for referees). Keyed on (team, index-within-team) so the
+      // hidden set is deterministic and matches the scenario's AddPlayer order.
+      // Controlled at runtime by GFOOTBALL_HIDE_SLOTS: a comma list of tokens like
+      // "L1,L2,R3" (L=left team, R=right team, number = index within team). Read live
+      // on each activation (i.e. every env.reset), so the set can change between
+      // render passes within a single process.
+      const char *hideSlots = getenv("GFOOTBALL_HIDE_SLOTS");
+      if (hideSlots && hideSlots[0] != '\0') {
+        DO_VALIDATION;
+        std::string token =
+            std::string(GetID() == 0 ? "L" : "R") + int_to_str(i);
+        std::string haystack = std::string(",") + hideSlots + ",";
+        if (haystack.find("," + token + ",") != std::string::npos) {
+          player->CastHumanoid()->renderScale = 0.02f;
+        }
+      }
     }
