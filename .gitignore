# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Secrets — Week 7+ will introduce these for the VLM eval
.env
.env.*
!.env.example

# Generated stimuli (kept out of git; share via Drive/S3/git-lfs if needed)
experiments/clips/
experiments/stimuli/
experiments/asset_bundles/
experiments/rollout_*.json
experiments/nithil_work/_work/
experiments/nithil_work/_work/

# Per-stimulus work dirs (intermediate avi + dumps)
**/_work/
**/_work_*/

# Auto-generated scenario modules (cheap to regenerate, noisy as commits)
football/gfootball/scenarios/x_*.py
football/build/lib.macosx-26.0-arm64-cpython-314/gfootball/scenarios/x_*.py

# Compiled simulator — platform-specific, must be rebuilt per machine
football/build/

# Nested git repo and venvs that shouldn't ride along
football/.git/
football/.venv*/
football/.gfootball.egg-info/

# Engine static libs (Mac-built, useless on Windows/Linux; regenerable)
football/third_party/gfootball_engine/*.a
football/third_party/gfootball_engine/*.so
football/third_party/gfootball_engine/*.dylib

# Game data (32MB+ textures) — pip install gfootball provides this
football/third_party/gfootball_engine/data/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Big binaries that should never be committed
*.avi
*.mov
*.dump

# Large generated numpy frame arrays and render assets (12G+, regenerable; keep out of git)
*.npy
*.npz
*.zip
*.bmp
*.anim
*.ase
*.object
*.vert

# Rendered frame PNGs under generated result/data trees (code + small text artifacts still tracked)
experiments/nithil_work/results/**/*.png
data/videos/**/*.png

# MATCH_SITUATIONS intermediates (probe sheets, frame caches, event dumps — regenerable)
MATCH_SITUATIONS/_probe/
MATCH_SITUATIONS/_frames/
MATCH_SITUATIONS/_events/

# Ground-truth debug overlays (regenerable renders)
**/_gt_debug/

# Asset bundles are multi-hundred-MB copies of the engine data dir; rebuild with
# build_bundles.py / build_noname_bundles.py / apply_gen2_kits.py
experiments/asset_bundles/

# GEN2 intermediates: sweep logs, per-window frame npz, probe maps (all regenerable)
GEN2/_cache/

# GEN3 intermediates: same story — sweep logs, probe maps, plates, render npz
GEN3/_cache/

# GEN3_HARD intermediates: same story again (11 GB of renders and sweep logs)
GEN3_HARD/_cache/

# INTRO intermediates: the 500-frame raw render passes are 884 MB each and are
# rebuilt from the GEN3 sweep cache by `intro_clips.py render_vis/render_inv`
INTRO/_cache/
